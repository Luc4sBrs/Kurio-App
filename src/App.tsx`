    function NotFoundPage() { return <PageFrame><div className="empty-state"><div className="empty-icon"><Compass size={24} /></div><h1>Não encontramos esse caminho</h1><p>Mas tem muita coisa bonita esperando na página inicial.</p><Link className="button button-primary" to="/profile">Minha conta</Link></div></PageFrame> }

    function ScenarioControl({ focusNft }: { focusNft?: NFT }) {
      const toast = useToast(); const cart = useCart(); const [open, setOpen] = useState(false); const [scenario, setScenario] = useState('standard')
      const setMode = async (next: string) => { setScenario(next); try { await service.setScenario(next); toast(`Cenário de demonstração: ${scenarioLabels[next] ?? next}.`, 'info') } catch { toast('Não foi possível alterar o cenário.', 'error') } }
      const priceTarget = focusNft?.id ?? cart.data?.lines[0]?.nftId ?? 'ember-002'
      return (
        <div className={`demo-control ${open ? 'demo-open' : ''}`}>
          <button className="demo-toggle" onClick={() => setOpen((value) => !value)} aria-expanded={open}>
            <span className="demo-toggle-icon"><Sparkles size={14} /></span>
            <span>DEMO</span>
            <ChevronDown size={13} />
          </button>
          {open && (
            <div className="demo-panel">
              <div className="demo-panel-top">
                <span>CONTROLES de DEMONSTRAÇÃO</span>
                <button className="icon-button" onClick={() => setOpen(false)} aria-label="Fechar controles"><X size={14} /></button>
              </div>
              <label className="demo-label">
                Cenário de rede
                <select aria-label="Cenário de rede" value={scenario} onChange={(event) => void setMode(event.target.value)}>
                  {Object.entries(scenarioLabels).map(([value, label]) => <option key={value} value={value}>{label}</option>)}
                </select>
              </label>
              <div className="demo-actions">
                <button onClick={() => { emitScenario('scenario:price', priceTarget); toast('Enviando atualização de preço pelo Socket.IO.', 'info') }}>
                  <ArrowDownUp size={14} /> Alterar preço
                </button>
                <button onClick={() => { emitScenario('scenario:inventory', priceTarget, 1); toast('Enviando disponibilidade pelo Socket.IO.', 'info') }}>
                  <PackageCheck size={14} /> Edição quase esgotada
                </button>
                <button onClick={() => { emitScenario('scenario:duplicate', priceTarget); toast('Enviando evento repetido e antigo pelo Socket.IO.', 'info') }}>
                  <MoreHorizontal size={14} /> Duplicar evento (teste)
                </button>
              </div>
              <button className="demo-reset" onClick={async () => {
                await service.reset();
                localStorage.removeItem(couponKey);
                localStorage.removeItem(TOKEN_KEY);
                window.location.assign('/')
              }}>Restaurar cenário inicial</button>
              <small>Eventos passam pelo cliente Socket.IO · API REST simulada por MSW</small>
            </div>
          )}
        </div>
      )
    }
    const scenarioLabels: Record<string, string> = {
      standard: 'Padrão',
      empty: 'Catálogo vazio',
      slow: 'Rede lenta',
      variable: 'Latência variável',
      'http-error': 'Falha HTTP 503',
      'mutation-error': 'Falha de favorito',
      'payment-declined': 'Pagamento recusado',
      'session-expired': 'Sessão expirada',
      timeout: 'Timeout no pedido'
    }

    function validateSearch(search: Record<string, unknown>): Partial<SearchState> {
      const rawPage = Number(search.page ?? 1)
      const allowedSorts: SortKey[] = ['popular', 'newest', 'price-asc', 'price-desc']
      return {
        q: typeof search.q === 'string' ? search.q : undefined,
        category: typeof search.category === 'string' ? search.category : undefined,
        sort: allowedSorts.includes(search.sort as SortKey) ? search.sort as SortKey : undefined,
        page: Number.isFinite(rawPage) ? Math.max(1, rawPage) : undefined,
        minPrice: typeof search.minPrice === 'string' ? search.minPrice : undefined,
        maxPrice: typeof search.maxPrice === 'string' ? search.maxPrice : undefined,
        available: search.available === true || search.available === 'true' ? true : undefined
      }
    }
    const rootRoute = createRootRoute({ component: RootLayout, notFoundComponent: NotFoundPage })
    const HomeRoute = createRoute({ getParentRoute: () => rootRoute, path: '/', validateSearch, component: HomePage })
    const NFTRoute = createRoute({ getParentRoute: () => rootRoute, path: '/nft/$nftId', component: NFTDetailPage })
    const CartRoute = createRoute({ getParentRoute: () => rootRoute, path: '/cart', component: CartPage })
    const CheckoutRoute = createRoute({ getParentRoute: () => rootRoute, path: '/checkout', component: CheckoutPage })
    const OrderRoute = createRoute({ getParentRoute: () => rootRoute, path: '/order/$orderId', component: OrderPage })
    const LoginRoute = createRoute({ getParentRoute: () => rootRoute, path: '/login', validateSearch: (search: Record<string, unknown>): { returnTo?: string } => ({ returnTo: typeof search.returnTo === 'string' ? search.returnTo : undefined }), component: LoginPage })
    const RegisterRoute = createRoute({ getParentRoute: () => rootRoute, path: '/register', validateSearch: (search: Record<string, unknown>): { returnTo?: string } => ({ returnTo: typeof search.returnTo === 'string' ? search.returnTo : undefined }), component: RegisterPage })
    const ProfileRoute = createRoute({ getParentRoute: () => rootRoute, path: '/profile', component: ProfilePage })
    const WalletsRoute = createRoute({ getParentRoute: () => rootRoute, path: '/wallets', component: WalletsPage })
    const FavoritesRoute = createRoute({ getParentRoute: () => rootRoute, path: '/favorites', component: FavoritesPage })
    const routeTree = rootRoute.addChildren([HomeRoute, NFTRoute, CartRoute, CheckoutRoute, OrderRoute, LoginRoute, RegisterRoute, ProfileRoute, WalletsRoute, FavoritesRoute])
    export const router = createRouter({ routeTree, defaultPreload: 'intent', scrollRestoration: true })
    declare module '@tanstack/react-router' { interface Register { router: typeof router } }
    export default function App() { return <RouterProvider router={router} /> }
