    function WalletsPage() { return <Protected><WalletsContent /></Protected> }
    function WalletsContent() {
      const query = useQuery({ queryKey: keys.wallets(), queryFn: service.wallets }); const client = useQueryClient(); const toast = useToast()
      const [label, setLabel] = useState(''); const [address, setAddress] = useState(''); const [network, setNetwork] = useState('Ethereum'); const [error, setError] = useState('')
      const [editingId, setEditingId] = useState<string | null>(null)
      const [editLabel, setEditLabel] = useState('')
      const [editNetwork, setEditNetwork] = useState('Ethereum')

      const save = async (event: FormEvent) => {
        event.preventDefault(); setError('');
        try {
          await service.addWallet({ label, address, network });
          setLabel(''); setAddress('');
          await client.invalidateQueries({ queryKey: keys.wallets() });
          toast('Carteira adicionada.', 'success')
        } catch (reason) { setError(errorMessage(reason)) }
      }
      const update = async (id: string) => {
        try {
          await service.updateWallet(id, { label: editLabel, network: editNetwork });
          setEditingId(null);
          await client.invalidateQueries({ queryKey: keys.wallets() });
          toast('Carteira atualizada.', 'success')
        } catch (reason) { toast(errorMessage(reason), 'error') }
      }
      const primary = async (id: string) => {
        try {
          await service.setPrimaryWallet(id);
          await client.invalidateQueries({ queryKey: keys.wallets() });
          toast('Carteira principal atualizada.', 'success')
        } catch (reason) { toast(errorMessage(reason), 'error') }
      }

      return (
        <PageFrame className="account-frame">
          <div className="account-heading">
            <div>
              <div className="eyebrow"><span className="eyebrow-line" />SUA CONTA KURIO</div>
              <h1 className="page-title">Minhas carteiras</h1>
              <p>Gerencie suas carteiras para pagamentos simulados.</p>
            </div>
            <Link to="/profile" className="continue-link"><ArrowLeft size={14} /> Voltar ao perfil</Link>
          </div>
          <div className="wallets-page-layout">
            <section className="account-panel">
              <div className="panel-heading">
                <div>
                  <h2>Carteiras cadastradas</h2>
                  <p>Você pode salvar redes diferentes para seus próximos pedidos.</p>
                </div>
                <span className="panel-step">{String(query.data?.length ?? 0).padStart(2, '0')}</span>
              </div>
              {query.isPending ? (
                <Skeleton className="wallet-list-skeleton" />
              ) : query.data?.length ? (
                <div className="wallet-list">
                  {query.data.map((wallet) => (
                    editingId === wallet.id ? (
                      <div className="wallet-row" key={wallet.id} style={{ gap: '10px' }}>
                        <span className="wallet-option-icon"><WalletCards size={19} /></span>
                        <div style={{ flex: 1, display: 'grid', gridTemplateColumns: '1fr 120px', gap: '10px' }}>
                          <Input value={editLabel} onChange={(e) => setEditLabel(e.//target.value)} placeholder="Label" />
                          <Select value={editNetwork} onChange={(e) => setEditNetwork(e.target.value)}>{networkNames.map(n => <option key={n}>{n}</option>)}</Select>
                        </div>
                        <div style={{ display: 'flex', gap: '5px' }}>
                          <Button size="sm" onClick={() => void update(wallet.id)}><Check size={14} /></Button>
                          <Button size="sm" variant="ghost" onClick={() => setEditingId(null)}><X size={14} /></Button>
                        </div>
                      </div>
                    ) : (
                      <div className="wallet-row" key={wallet.id}>
                        <span className="wallet-option-icon"><WalletCards size={19} /></span>
                        <div>
                          <b>{wallet.label}</b>
                          <span>{shortAddress(wallet.address)} · {wallet.network}</span>
                        </div>
                        {wallet.primary ? (
                          <span className="primary-pill">PRINCIPAL</span>
                        ) : (
                          <div style={{ display: 'flex', gap: '5px' }}>
                            <Button variant="outline" size="sm" onClick={() => void primary(wallet.id)}>Tornar principal</Button>
                            <Button variant="ghost" size="sm" onClick={() => { setEditingId(wallet.id); setEditLabel(wallet.label); setEditNetwork(wallet.network); }}>
                              <ArrowDownUp size={14} />
                            </Button>
                          </div>
                        )}
                      </div>
                    )
                  ))}
                </div>
              ) : (
                <div className="wallet-empty">
                  <WalletCards size={23} />
                  <b>Nenhuma carteira cadastrada</b>
                  <span>Adicione uma carteira para usá-la durante o checkout.</span>
                </div>
              )}
            </section>
            <section className="account-panel add-wallet-panel">
              <div className="panel-heading">
                <div>
                  <h2>Adicionar carteira</h2>
                  <p>Insira um endereço compatível com Ethereum.</p>
                </div>
                <span className="panel-step">+</span >
              </div>
              <form onSubmit={(event) => void save(event)} className="wallet-form">
                <Input label="Nome da carteira" id="wallet-label" value={label} onChange={(event) => setLabel(event.target.value)} placeholder="Ex.: Minha MetaMask" required />
                <Input label="Endereço da carteira" id="wallet-address" value={address} onChange={(event) => setAddress(event.target.value)} placeholder="0x..." required hint="40 caracteres hexadecimais após 0x." />
                <Select label="Rede" id="wallet-network" value={network} onChange={(event) => setNetwork(event.target.value)}>{networkNames.map((item) => <option key={item}>{item}</option>)}</Select>
                {error && <p className="form-alert">{error}</p>}
                <Button type="submit">Adicionar carteira <Plus size={15} /></Button>
                <p className="wallet-sim-note"><ShieldCheck size={14} /> Não conectamos carteiras reais neste ambiente.</p>
              </form>
            </section>
          </div>
          <ScenarioControl />
        </PageFrame>
      )
    }

